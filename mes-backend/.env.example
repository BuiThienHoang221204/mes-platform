# Bản mẫu — file này CÓ lên git. Chép thành .env rồi sửa:
#     cp .env.example .env
#
# Mọi biến phải có tiền tố MES_. Thứ tự ưu tiên:
#     biến môi trường thật  >  file .env  >  mặc định trong app/common/config.py
# Nên ở production KHÔNG cần .env — đặt thẳng biến môi trường là được.
#
# Đơn vị thời gian nằm ngay trong TÊN BIẾN: _MINUTES, _DAYS, _SECONDS.

# dev | staging | prod
MES_ENV=dev

# ── BẮT BUỘC — thiếu là app từ chối khởi động ────────────────────────────────
# Postgres. Khớp docker compose: `docker compose up -d db`
MES_DATABASE_URL=postgresql+psycopg://mes:mes@localhost:5432/mes

# Khoá ký token, tối thiểu 32 ký tự. Sinh khoá mới:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
MES_JWT_SECRET=doi-cai-nay-o-may-that-toi-thieu-32-ky-tu

# ── Có thể bỏ trống, dưới đây là giá trị mặc định ───────────────────────────
# Access đi kèm MỌI request nên để ngắn.
MES_JWT_ACCESS_TTL_MINUTES=15
# Refresh đổi lấy access mới mà không bắt đăng nhập lại.
MES_JWT_REFRESH_TTL_DAYS=7
# Token gắn vào THIẾT BỊ đặt cố định ở trạm — không ai đăng nhập lại mỗi ngày.
MES_JWT_STATION_TTL_DAYS=365

# Đầu đọc bắn hai lần trong ngần này giây thì coi là một lần (BRD §1b.3)
MES_SCAN_DEDUPE_SECONDS=2.0

# Kết nối DB. 4 worker × (5 + 5) = tối đa 40 kết nối — so với max_connections của Postgres.
MES_DATABASE_POOL_SIZE=5
MES_DATABASE_MAX_OVERFLOW=5
# true = in mọi câu SQL ra log. Chỉ bật khi đang soi lỗi.
MES_DATABASE_ECHO=false

# ── Cookie chứa token ───────────────────────────────────────────────────────
# true = chỉ gửi qua HTTPS. Máy phát triển chạy http thì đặt false.
MES_COOKIE_SECURE=true
# lax  = FE và BE CÙNG site (qua reverse proxy) — chặn được CSRF.
# none = FE khác origin — BUỘC secure=true, và mất lá chắn CSRF của trình duyệt,
#        lúc đó phải thêm CSRF token.
MES_COOKIE_SAMESITE=lax
# Bỏ trống = đúng host đang phục vụ.
# MES_COOKIE_DOMAIN=.congty.vn

# ── CORS ────────────────────────────────────────────────────────────────────
# Origin của FE, dạng danh sách JSON. KHÔNG dùng "*" khi có cookie.
MES_CORS_ORIGINS='["http://localhost:3000"]'

# ── Postgres của docker compose ─────────────────────────────────────────────
# docker-compose.yml đọc những biến này. THIẾU thì compose dừng ngay, không chạy
# bằng chuỗi rỗng. Sinh mật khẩu mới:
#     python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=mes
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=mes
# Cổng mở ra máy chủ. Ở máy thật nên bỏ hẳn phần ports trong compose.
POSTGRES_PORT=5432
API_PORT=8000
